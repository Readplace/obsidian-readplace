{
	"name": "obsidian-readplace",
	"version": "0.1.3",
	"description": "Sync articles you saved in Readplace into your vault as Markdown notes, with the full text, the AI summary and reading status.",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit",
		"lint": "eslint .",
		"test": "jest",
		"test:e2e": "playwright test",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@eslint/json": "0.14.0",
		"@playwright/test": "1.60.0",
		"@types/jest": "30.0.0",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.14.0",
		"jest": "30.5.2",
		"obsidian": "1.14.4",
		"ts-jest": "29.4.15",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1"
	},
	"dependencies": {
		"zod": "4.6.7"
	}
}
